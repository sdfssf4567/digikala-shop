# ===============================================
# فایل htaccess - تنظیمات امنیتی و سرور
# ===============================================

# غیرفعال کردن نمایش لیست فایل‌های پوشه‌ها
Options -Indexes

# جلوگیری از دسترسی مستقیم به فایل‌های حساس
<FilesMatch "^(config\.php|Database\.php|helpers\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# جلوگیری از دسترسی به پوشه‌های هسته و پیکربندی
RedirectMatch 403 ^/.*/(config|core|controllers|models)/.*\.php$

# هدرهای امنیتی
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
